/target/
/.build/
**/.build/
/.swiftpm/
/DerivedData/
/.afterray-dev/
/.afterray/
/dist/
*.xcuserstate
.DS_Store
__pycache__/
*.pyc

# Offscreen visual snapshots (make snapshots)
/snapshots/

# Agent-session workspaces: pinned eval worktrees, serving shims, recovered
# fragments. Never repo content; a worktree checked out inside the repo must
# be ignored or every session reads as a dirty tree.
/.scratch/
/.claude/

# Local state written by `wrangler pages dev` (simulated R2, build cache).
/.wrangler/
/site/.wrangler/
